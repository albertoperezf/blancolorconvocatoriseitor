# Production (Vercel): Neon pooled connection string.
# Locally leave it unset: `npm run dev` starts PGlite (.data/dev) as a Postgres server and injects DATABASE_URL,
# and `npm run db:seed` / `db:migrate` open .data/dev directly (stop `npm run dev` first).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin used in password-reset links (set in production)
APP_URL=http://localhost:3000

# First admin, created by `npm run db:seed` (must change the password on first login)
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_TEMP_PASSWORD=

# Push notifications (Monday/Wednesday reminders). Generate the pair with `npx web-push generate-vapid-keys`.
# Without them the "Notificaciones" box and banner are hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron sends it as a Bearer token to /api/cron/recordatorio (e.g. `openssl rand -hex 32`).
CRON_SECRET=
